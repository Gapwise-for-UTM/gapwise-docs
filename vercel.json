{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/status/",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "status.gapwise.ca"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/status/_data/current",
      "destination": "https://api.github.com/repos/andrewmuratov/gapwise-docs/issues/17"
    },
    {
      "source": "/status/_data/history",
      "destination": "https://api.github.com/repos/andrewmuratov/gapwise-docs/issues/17/comments"
    }
  ],
  "headers": [
    {
      "source": "/status/_data/current",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=60, stale-while-revalidate=3600, stale-if-error=86400"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=30"
        }
      ]
    },
    {
      "source": "/status/_data/history",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=300, stale-while-revalidate=3600, stale-if-error=86400"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
